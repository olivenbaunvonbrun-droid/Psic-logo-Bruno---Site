    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { ShieldAlert, Award, Shield, CheckCircle, GraduationCap, Users } from \'lucide-react\';\n\nexport default function AboutTherapist() {\n  const specializedTags = [\n    \"Acompanhamento Psicol\303\263gico\",\n    \"Desenvolvimento Pessoal\",\n    \"Intelig\303\252ncia Emocional\",\n    \"Tratamento de Traumas\",\n    \"Supera\303\247\303\243o de Tristeza\",\n    \"Lidar com Medos & Fobias\",\n    \"Altera\303\247\303\265es de Humor\",\n    \"Superar Depend\303\252ncia Emocional\",\n    \"Aumento de Autoestima\"\n  ];\n\n  const credentials = [\n    { title: \"Forma\303\247\303\243o em Neuroci\303\252ncias\", school: \"Investiga\303\247\303\243o dos padr\303\265es cerebrais e de sinapses f\303\255sicas\" },\n    { title: \"Especialista em TCC de 4\302\252 Gera\303\247\303\243o\", school: \"Flexibilidade psicol\303\263gica, ACT e Mindfulness integrados\" },\n    { title: \"Abordagem Psicanal\303\255tica e Humanista\", school: \"Ressignifica\303\247\303\243o profunda de traumas de inf\303\242ncia\" },\n    { title: \"Atendimento Cl\303\255nico Filiado ao CFP\", school: \"Regularizado no e-Psi para sess\303\265es online nacionais e internacionais\" }\n  ];\n\n  const handleWhatsAppClick = () => {\n    const text = encodeURIComponent(\n      \"Ol\303\241, Dr. Bruno! Estava lendo sua biografia profissional e gostaria de agendar um hor\303\241rio com voc\303\252.\"\n    );\n    window.open(`https://wa.me/5521975249514?text=${text}`, \'_blank\');\n  };\n\n  return (\n    <section \n      id=\"terapeuta\"\n      className=\"py-24 bg-luxury-black relative overflow-hidden\"\n    >\n      {/* Visual top border styling */}\n      <div className=\"absolute top-0 left-1/2 -translate-x-1/2 w-4/5 h-[1px] bg-gradient-to-r from-transparent via-luxury-gold/20 to-transparent\" />\n\n      <div className=\"max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10\">\n        \n        {/* Left Column (Luxury Badge / Illustration Frame / Photo Layout) */}\n        <div className=\"lg:col-span-5 flex justify-center\">\n          <motion.div \n            id=\"therapist-biography-card\"\n            className=\"w-full max-w-[390px] rounded-2xl relative overflow-hidden bg-luxury-charcoal/30 border border-luxury-gold/15 p-6 shadow-2xl flex flex-col gap-6\"\n            initial={{ opacity: 0, x: -30 }}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true }}\n            transition={{ duration: 0.8 }}\n          >\n            {/* The circular portrait container replicating profile layout */}\n            <div className=\"relative w-44 h-44 rounded-full border-2 border-luxury-gold/40 mx-auto overflow-hidden bg-gradient-to-b from-[#1b1b1e] to-luxury-black p-1\">\n              <div className=\"w-full h-full rounded-full overflow-hidden bg-luxury-black relative flex items-center justify-center\">\n                {/* Silhouette avatar representing Bruno */}\n                <svg viewBox=\"0 0 100 100\" className=\"w-[85%] h-[85%] text-luxury-gold/5 mt-4\">\n                  <path fill=\"currentColor\" d=\"M10,95 C10,65 30,55 50,55 C70,55 90,65 90,95 Z\" />\n                  <circle cx=\"50\" cy=\"35\" r=\"20\" fill=\"currentColor\" />\n                </svg>\n                \n                {/* Warm orange radial lighting and overlays */}\n                <div className=\"absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(197,168,128,0.15)_0%,transparent_70%)] pointer-events-none\" />\n\n                {/* Real-life circular watermark symbol */}\n                <div className=\"absolute bottom-2 left-1/2 -translate-x-1/2 bg-luxury-charcoal border border-luxury-gold/20 text-[#dfcaa7] rounded-full px-2 py-0.5 text-[8px] font-mono tracking-widest uppercase shadow\">\n                  e-Psi CFP\n                </div>\n              </div>\n            </div>\n\n            {/* Quick Consultation Badge matching PsyMeet info details text */}\n            <div className=\"text-center\">\n              <span className=\"text-[10px] font-sans text-luxury-gold uppercase tracking-[0.25em] font-bold\">Inscri\303\247\303\243o Profissional</span>\n              <h3 className=\"text-xl font-serif text-white font-semibold mt-1\">Bruno de Oliveira Lima</h3>\n              <p className=\"text-xs text-luxury-gold-light mt-0.5 font-medium tracking-wide\">Psic\303\263logo Cl\303\255nico Integrativo</p>\n              <p className=\"text-[10px] text-zinc-500 font-mono mt-1\">CRP: 05/75885</p>\n            </div>\n\n            {/* Structured details mapping tags from platform */}\n            <div className=\"border-t border-white/[0.05] pt-5 flex flex-col gap-3\">\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"text-luxury-text-muted\">Valor M\303\251dio da Consulta:</span>\n                <span className=\"text-luxury-gold font-mono font-semibold\">Consulte Pacotes</span>\n              </div>\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"text-luxury-text-muted\">M\303\251todo Predominante:</span>\n                <span className=\"text-white font-semibold\">TCC 4\302\252 Gera\303\247\303\243o</span>\n              </div>\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"text-luxury-text-muted\">P\303\272blico Alvo:</span>\n                <span className=\"text-white font-semibold\">Adolescentes \342\200\242 Adultos</span>\n              </div>\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"text-luxury-text-muted\">Formato de Sess\303\243o:</span>\n                <span className=\"text-[#dfcaa7] font-semibold\">Online (Plataforma Segura)</span>\n              </div>\n            </div>\n\n            {/* Active ethical certification notice */}\n            <div className=\"bg-emerald-500/5 p-3 rounded-xl border border-emerald-500/20 text-[10px] text-emerald-400 flex items-center gap-2 justify-center leading-relaxed\">\n              <Shield className=\"w-4 h-4 shrink-0 text-emerald-400\" />\n              <span>Aprovado para Atendimento Online Conselho CFP</span>\n            </div>\n\n          </motion.div>\n        </div>\n\n        {/* Right Column: Bio Narrative copy & specialized tags (7 columns) */}\n        <div className=\"lg:col-span-7 text-left flex flex-col items-start justify-center\">\n          \n          <div className=\"flex items-center gap-2 mb-4\">\n            <Award className=\"w-4 h-4 text-luxury-gold\" />\n            <span className=\"text-xs font-sans tracking-[0.3em] uppercase text-luxury-gold-light font-medium\">Sobre o Psicoterapeuta</span>\n          </div>\n\n          <h2 className=\"text-3xl sm:text-4xl md:text-5xl font-serif text-white tracking-tight leading-tight mb-8\">\n            Conhe\303\247a o profissional \303\240 frente do seu <span className=\"gold-gradient-text italic font-medium\">processo de cura.</span>\n          </h2>\n\n          <div className=\"text-xs sm:text-sm text-luxury-text-muted leading-relaxed font-sans font-light flex flex-col gap-6 mb-8 max-w-2xl\">\n            <p>\n              \"Sou um Psicoterapeuta Cognitivo Comportamental de 4\302\252 Gera\303\247\303\243o. Acredito firmemente em um olhar cl\303\255nico integrativo sobre o ser humano e tenho como foco ajudar meus pacientes a desenvolverem as compet\303\252ncias psicol\303\263gicas e neurocient\303\255ficas necess\303\241rias para alcan\303\247arem seus maiores objetivos na vida.\"\n            </p>\n            <p>\n              \"Entendo as dores do dia a dia \342\200\224 depress\303\243o severa, traumas persistentes da juventude, ansiedade inflada, baixa autoestima cr\303\264nica e outras demandas intensas de comportamento. Carrego comigo a convic\303\247\303\243o inabal\303\241vel de que a minha miss\303\243o profissional e de vida \303\251 contribuir para diminuir o sofrimento no mundo de maneira cient\303\255fica.\"\n            </p>\n          </div>\n\n          {/* Training list */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 w-full mb-10\">\n            {credentials.map((cred, idx) => (\n              <div key={idx} className=\"flex gap-3 items-starts bg-luxury-charcoal/30 p-4 rounded-xl border border-white/5\">\n                <CheckCircle className=\"w-5 h-5 text-luxury-gold shrink-0 mt-0.5\" />\n                <div>\n                  <h4 className=\"text-xs sm:text-sm font-serif text-white font-semibold leading-normal\">{cred.title}</h4>\n                  <p className=\"text-[11px] text-zinc-500 mt-1 font-light leading-normal\">{cred.school}</p>\n                </div>\n              </div>\n            ))}\n          </div>\n\n          {/* Specializations list tags */}\n          <div className=\"w-full flex flex-col gap-4\">\n            <h4 className=\"text-xs font-sans tracking-[0.2em] uppercase text-luxury-gold/80 font-bold\">Campos Cl\303\255nicos de Atua\303\247\303\243o</h4>\n            <div className=\"flex flex-wrap gap-2\">\n              {specializedTags.map((tag) => (\n                <span \n                  key={tag}\n                  className=\"px-3.5 py-1.5 rounded-full bg-luxury-charcoal text-zinc-300 text-xs font-sans border border-white/5 hover:border-luxury-gold/30 hover:text-white transition duration-300 select-none\"\n                >\n                  {tag}\n                </span>\n              ))}\n            </div>\n          </div>\n\n          {/* Direct CTA button to book with Bruno */}\n          <button\n            id=\"about-me-whatsapp-btn\"\n            onClick={handleWhatsAppClick}\n            className=\"flex items-center gap-2 bg-gradient-to-r from-luxury-gold-dark via-luxury-gold to-luxury-gold-light text-luxury-black font-semibold text-xs uppercase tracking-widest px-8 py-4 px-8 py-4 rounded-full mt-10 transition hover:brightness-110 active:scale-95 shadow-lg shadow-luxury-gold/10 cursor-pointer\"\n          >\n            <span>Conversar Diretamente com Dr. Bruno</span>\n          </button>\n\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
