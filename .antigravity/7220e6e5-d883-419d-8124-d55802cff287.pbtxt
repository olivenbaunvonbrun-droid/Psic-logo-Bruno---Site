        }
        lines {
          text: "    role: \"Advogada Corporativa\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    text: \"Cheguei ao Bruno carregando um esgotamento terr\303\255vel e uma ansiedade que travava meu peito todas as manh\303\243s. Eu sentia que precisava ser perfeita em tudo, mas s\303\263 acumulava medos e depend\303\252ncia da opini\303\243o alheia. A psicoterapia foi um divisor de \303\241guas. O jeito firme, por\303\251m profundamente humano e sem julgamentos do Bruno, apoiado na TCC de 4\302\252 gera\303\247\303\243o, me fez compreender e acolher minha hist\303\263ria. Hoje respiro mais leve, sei colocar limites e recuperei o comando da minha mente.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
