    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { ShieldCheck, Sparkles, MessageSquareHeart, CheckCircle, ArrowDown } from \'lucide-react\';\n\nexport default function Hero() {\n  const handleWhatsAppClick = () => {\n    const text = encodeURIComponent(\n      \"Ol\303\241, Dr. Bruno! Estou vindo do seu site de luxo e gostaria de agendar uma consulta inicial com voc\303\252.\"\n    );\n    window.open(`https://wa.me/5521975249514?text=${text}`, \'_blank\');\n  };\n\n  return (\n    <section \n      id=\"hero-root\"\n      className=\"relative min-h-screen pt-32 pb-20 flex items-center justify-center overflow-hidden bg-radial from-luxury-charcoal to-luxury-black\"\n    >\n      {/* Background ambient gold lights */}\n      <div className=\"absolute top-1/4 left-1/4 w-[40rem] h-[40rem] bg-luxury-gold/5 rounded-full blur-[120px] pointer-events-none\" />\n      <div className=\"absolute bottom-1/4 right-1/4 w-[35rem] h-[35rem] bg-luxury-gold/5 rounded-full blur-[100px] pointer-events-none\" />\n\n      {/* Decorative vertical lines representing clean architectural columns of premium office */}\n      <div className=\"absolute inset-0 bg-[linear-gradient(to_right,#ffffff03_1px,transparent_1px)] bg-[size:100px_100%] pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-6 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10\">\n        \n        {/* Left Content Column */}\n        <div className=\"lg:col-span-7 flex flex-col items-start text-left\">\n          \n          <motion.div \n            id=\"hero-tagline-badge\"\n            className=\"flex items-center gap-2 px-3 py-1.5 rounded-full bg-luxury-gold/10 border border-luxury-gold/20 text-[10px] sm:text-xs tracking-widest text-[#dfcaa7] font-sans font-medium uppercase mb-6\"\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.6 }}\n          >\n            <Sparkles className=\"w-3.5 h-3.5 text-luxury-gold\" />\n            <span>TCC de 4\302\252 Gera\303\247\303\243o & Neuroci\303\252ncia</span>\n          </motion.div>\n\n          <motion.h1 \n            id=\"hero-title\"\n            className=\"text-4xl sm:text-5xl md:text-6xl font-serif text-white tracking-tight leading-[1.1] mb-6\"\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.1 }}\n          >\n            Toda ferida silenciosa merece um <span className=\"gold-gradient-text italic font-medium\">olhar acolhedor</span> e humanizado.\n          </motion.h1>\n\n          <motion.p \n            id=\"hero-description\"\n            className=\"text-sm sm:text-base md:text-lg text-luxury-text-muted leading-relaxed font-sans font-light max-w-xl mb-10\"\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.2 }}\n          >\n            Seja bem-vindo a um porto seguro de transforma\303\247\303\243o pessoal. Sou o Dr. Bruno de Oliveira Lima, especialista em acolher ansiedade, traumas, esgotamentos e depend\303\252ncia emocional de maneira cient\303\255fica, humanizada e sob sigilo \303\251tico absoluto.\n          </motion.p>\n\n          {/* Quick value props */}\n          <motion.div \n            id=\"hero-features\"\n            className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10 w-full max-w-lg\"\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.3 }}\n          >\n            <div className=\"flex items-start gap-3\">\n              <CheckCircle className=\"w-5 h-5 text-luxury-gold shrink-0 mt-0.5\" />\n              <div>\n                <h4 className=\"text-sm font-semibold text-white tracking-wide\">Sem Julgamentos</h4>\n                <p className=\"text-xs text-luxury-text-muted mt-0.5\">Espa\303\247o pautado pelo acolhimento, respeito m\303\272tuo e dignidade humana.</p>\n              </div>\n            </div>\n            <div className=\"flex items-start gap-3\">\n              <CheckCircle className=\"w-5 h-5 text-luxury-gold shrink-0 mt-0.5\" />\n              <div>\n                <h4 className=\"text-sm font-semibold text-white tracking-wide\">Abordagem Integrada</h4>\n                <p className=\"text-xs text-luxury-text-muted mt-0.5\">O melhor da Psican\303\241lise, Humanismo, TCC e as Neuroci\303\252ncias.</p>\n              </div>\n            </div>\n            <div className=\"flex items-start gap-3\">\n              <CheckCircle className=\"w-5 h-5 text-luxury-gold shrink-0 mt-0.5\" />\n              <div>\n                <h4 className=\"text-sm font-semibold text-white tracking-wide\">Atendimento Online VIP</h4>\n                <p className=\"text-xs text-luxury-text-muted mt-0.5\">Consultas por videoconfer\303\252ncia com total sigilo criptografado.</p>\n              </div>\n            </div>\n            <div className=\"flex items-start gap-3\">\n              <CheckCircle className=\"w-5 h-5 text-luxury-gold shrink-0 mt-0.5\" />\n              <div>\n                <h4 className=\"text-sm font-semibold text-white tracking-wide\">CRP Ativo e Regular</h4>\n                <p className=\"text-xs text-luxury-text-muted mt-0.5\">Dr. Bruno de Oliveira Lima, Conselho de Psicologia CRP 05/75885.</p>\n              </div>\n            </div>\n          </motion.div>\n\n          {/* Action buttons */}\n          <motion.div \n            id=\"hero-actions\"\n            className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full\"\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.4 }}\n          >\n            <button\n              id=\"hero-whatsapp-btn\"\n              onClick={handleWhatsAppClick}\n              className=\"flex items-center justify-center gap-2.5 bg-gradient-to-r from-luxury-gold-dark via-luxury-gold to-luxury-gold-light text-luxury-black font-semibold text-sm uppercase tracking-wider px-8 py-4.5 rounded-full shadow-lg hover:shadow-luxury-gold/20 active:scale-95 transition cursor-pointer\"\n            >\n              <MessageSquareHeart className=\"w-5 h-5\" />\n              <span>Agendar Minha Consulta</span>\n            </button>\n            \n            <a\n              href=\"#terapeuta\"\n              id=\"hero-about-btn\"\n              className=\"flex items-center justify-center gap-2 border border-luxury-gold/30 hover:border-luxury-gold/70 text-luxury-gold-light hover:text-white px-8 py-4.5 rounded-full text-sm font-semibold uppercase tracking-wider transition\"\n            >\n              <span>Conhecer o Dr. Bruno</span>\n              <ArrowDown className=\"w-4 h-4 animate-bounce\" />\n            </a>\n          </motion.div>\n\n        </div>\n\n        {/* Right Column: Replicating the Visual Identity exactly matching the photos */}\n        <div className=\"lg:col-span-5 flex justify-center items-center\">\n          <motion.div\n            id=\"hero-portrait-card\"\n            className=\"w-full max-w-[420px] rounded-2xl relative overflow-hidden bg-luxury-charcoal/40 border border-luxury-gold/20 p-5 shadow-2xl flex flex-col gap-6\"\n            initial={{ opacity: 0, scale: 0.95, y: 30 }}\n            animate={{ opacity: 1, scale: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.2 }}\n          >\n            {/* Top gold decor lines mimicking classic architectural styling arches */}\n            <div className=\"absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-luxury-gold/40 to-transparent\" />\n            \n            {/* The Psychologist Frame: stylized depiction with dark elegant layout mimicking the first images */}\n            <div className=\"relative w-full aspect-[4/5] rounded-xl overflow-hidden bg-gradient-to-b from-[#1c1c20] to-[#0c0c0d] border border-white/[0.05] group flex flex-col justify-end items-center p-6\">\n              \n              {/* Radial warm lighting from background */}\n              <div className=\"absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(197,168,128,0.12)_0%,transparent_75%)] pointer-events-none\" />\n\n              {/* Textured pattern matching matte-black wainscoting paneling */}\n              <div className=\"absolute inset-0 flex p-4 justify-between pointer-events-none opacity-40\">\n                <div className=\"w-[1px] h-full bg-white/[0.03] ml-[15%]\" />\n                <div className=\"w-[1px] h-full bg-white/[0.03]\" />\n                <div className=\"w-[1px] h-full bg-white/[0.03] mr-[15%]\" />\n              </div>\n\n              {/* Elegantly styled portrait placeholder or stylized vector art of Bruno looking confident, bearded and arms crossed */}\n              <div className=\"absolute inset-0 flex flex-col items-center justify-center px-4 text-center pointer-events-none\">\n                <div className=\"relative w-full h-[85%] flex items-end justify-center\">\n                  \n                  {/* Stylized high-luxury silhouette of the therapist */}\n                  <svg id=\"therapist-silhouette\" viewBox=\"0 0 200 240\" className=\"w-[78%] h-full text-[#121214] drop-shadow-[0_15px_15px_rgba(0,0,0,0.6)]\">\n                    {/* Beard / Face detail shaded with premium gold accents */}\n                    <path \n                      fill=\"currentColor\" \n                      d=\"M20,240 C20,180 50,150 100,150 C150,150 180,180 180,240 Z\" \n                    />\n                    {/* Suit Collar and Tie */}\n                    <path d=\"M75,150 L100,180 L125,150 L100,165 Z\" fill=\"#242428\" />\n                    <path d=\"M96,178 L104,178 L108,225 L100,235 L92,225 Z\" fill=\"#c5a880\" opacity=\"0.8\" />\n                    {/* Face & beard */}\n                    <circle cx=\"100\" cy=\"90\" r=\"42\" fill=\"#1f1f23\" />\n                    <path d=\"M70,85 C68,115 85,130 100,130 C115,130 132,115 130,85 C130,60 115,55 100,55 C85,55 70,60 70,85 Z\" fill=\"currentColor\" />\n                    {/* Crown Hair Style */}\n                    <path d=\"M75,55 C85,45 100,42 110,45 C115,48 122,50 125,55 C122,58 118,52 110,54 C100,56 85,62 75,55 Z\" fill=\"#080809\" />\n                  </svg>\n\n                  {/* Absolute positioning ambient glow */}\n                  <div className=\"absolute top-[40%] left-1/2 -translate-x-1/2 w-48 h-48 rounded-full bg-luxury-gold/5 filter blur-xl pointer-events-none\" />\n                </div>\n              </div>\n\n              {/* Overlay elements mapping directly onto the image visuals */}\n              <div className=\"relative z-10 w-full bg-luxury-black/90 p-4 rounded-lg border border-luxury-gold/20 backdrop-blur-md flex flex-col items-center shadow-lg\">\n                \n                {/* Gold Psi Mandala exactly representing the penult picture */}\n                <div className=\"w-12 h-12 rounded-full border border-luxury-gold/50 flex items-center justify-center bg-[#07090f] relative shadow-inner\">\n                  {/* Mandala circular paths */}\n                  <svg className=\"absolute inset-0 w-full h-full text-luxury-gold/30 animate-spin-slow\" viewBox=\"0 0 100 100\">\n                    <circle cx=\"50\" cy=\"50\" r=\"46\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1\" strokeDasharray=\"3 3\" />\n                    <circle cx=\"50\" cy=\"50\" r=\"40\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"0.5\" />\n                    <circle cx=\"50\" cy=\"50\" r=\"34\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1\" strokeDasharray=\"5 2\" />\n                  </svg>\n                  <span className=\"text-luxury-gold text-lg font-bold font-serif relative z-10\">\316\250</span>\n                </div>\n\n                {/* Elegant names */}\n                <h3 className=\"font-serif italic text-lg text-white font-semibold mt-2.5 leading-none\">\n                  Bruno de Oliveira\n                </h3>\n                <p className=\"text-[10px] sm:text-xs text-luxury-gold-light tracking-widest font-sans font-medium uppercase mt-1\">\n                  PSIC\303\223LOGO | CRP 05/75885\n                </p>\n                <p className=\"text-[10px] font-mono text-luxury-text-muted mt-1.5 opacity-80\">\n                  (21) 97524-9514\n                </p>\n              </div>\n\n              {/* Visual sign with physical telephone to highlight real life representation */}\n              <span className=\"absolute top-3 left-3 bg-[#111] border border-emerald-500/30 text-emerald-400 font-mono text-[9px] px-2 py-0.5 rounded-full flex items-center gap-1\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping\" />\n                Sess\303\265es Dispon\303\255veis\n              </span>\n            </div>\n\n            {/* Extra details corresponding to the luxury style of the therapist */}\n            <div className=\"flex justify-between items-center bg-luxury-charcoal/80 p-3 rounded-xl border border-luxury-gold/5 text-center\">\n              <div className=\"flex-1 border-r border-white/5\">\n                <p className=\"text-[10px] text-luxury-text-muted tracking-wider uppercase font-sans\">Abordagem</p>\n                <p className=\"text-xs text-white font-semibold mt-1\">TCC Integrativa</p>\n              </div>\n              <div className=\"flex-1 border-r border-white/5\">\n                <p className=\"text-[10px] text-luxury-text-muted tracking-wider uppercase font-sans\">P\303\272blico</p>\n                <p className=\"text-xs text-white font-semibold mt-1\">Adulto e Jovem</p>\n              </div>\n              <div className=\"flex-1\">\n                <p className=\"text-[10px] text-luxury-text-muted tracking-wider uppercase font-sans\">Formato</p>\n                <p className=\"text-xs text-luxury-gold-light font-semibold mt-1\">Online VIP</p>\n              </div>\n            </div>\n          </motion.div>\n        </div>\n\n      </div>\n\n      {/* Elegant scroll down decor */}\n      <div className=\"absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 opacity-40 hover:opacity-100 transition cursor-pointer\">\n        <span className=\"text-[9px] font-sans tracking-[0.3em] uppercase text-luxury-gold-light\">Saiba Mais</span>\n        <div className=\"w-[1px] h-8 bg-gradient-to-b from-luxury-gold to-transparent\" />\n      </div>\n\n    </section>\n  );\n}\n"
    }
