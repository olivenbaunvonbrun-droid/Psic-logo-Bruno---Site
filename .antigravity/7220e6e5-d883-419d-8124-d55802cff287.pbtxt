    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { Testimonial, PainPoint, AssessmentQuestion, FaqItem } from \'./types\';\n\nexport const TESTIMONIALS: Testimonial[] = [\n  {\n    id: \'t1\',\n    name: \"Mariana S.\",\n    age: 34,\n    location: \"Rio de Janeiro - RJ\",\n    role: \"Advogada Corporativa\",\n    text: \"Cheguei ao Dr. Bruno carregando um esgotamento terr\303\255vel e uma ansiedade que travava meu peito todas as manh\303\243s. Eu sentia que precisava ser perfeita em tudo, mas s\303\263 acumulava medos e depend\303\252ncia da opini\303\243o alheia. A psicoterapia foi um divisor de \303\241guas. O jeito firme, por\303\251m profundamente humano e sem julgamentos do Bruno, apoiado na TCC de 4\302\252 gera\303\247\303\243o, me fez compreender e acolher minha hist\303\263ria. Hoje respiro mais leve, sei colocar limites e recuperei o comando da minha mente.\",\n    outcome: \"Recupera\303\247\303\243o do p\303\242nico e burnout, restabelecimento de limites saud\303\241veis de trabalho.\"\n  },\n  {\n    id: \'t2\',\n    name: \"Rodrigo M.\",\n    age: 29,\n    location: \"S\303\243o Paulo - SP\",\n    role: \"Empreendedor de Tecnologia\",\n    text: \"Minhas rela\303\247\303\265es eram pautadas pela depend\303\252ncia emocional e o medo constante da rejei\303\247\303\243o. Eu me abandonava para agradar os outros e sofria com flutua\303\247\303\265es severas de humor e depress\303\243o silenciosa. A terapia com o Bruno me trouxe intelig\303\252ncia de verdade sobra as minhas emo\303\247\303\265es. Ele me ensinou conceitos da neuroci\303\252ncia e estrat\303\251gias pr\303\241ticas que mudaram minha forma de agir. O consult\303\263rio dele online \303\251 um ref\303\272gio de dignidade e acolhimento.\",\n    outcome: \"Supera\303\247\303\243o da depend\303\252ncia emocional, independ\303\252ncia afetiva e estabiliza\303\247\303\243o do humor.\"\n  },\n  {\n    id: \'t3\',\n    name: \"Helo\303\255sa F.\",\n    age: 42,\n    location: \"Niter\303\263i - RJ\",\n    role: \"M\303\251dica Pediatra\",\n    text: \"O Dr. Bruno de Oliveira \303\251 de uma sensibilidade \303\255mpar. Carrego traumas de inf\303\242ncia complexos que reverberavam na minha forma de maternar e na minha autoestima. Ele une a profundidade da compreens\303\243o humana com ferramentas cient\303\255ficas de ponta. Sentir que voc\303\252 est\303\241 sendo verdadeiramente ouvida por um profissional de alt\303\255ssimo n\303\255vel, cuja miss\303\243o clara \303\251 reduzir a dor, muda de forma crucial a nossa autoconfian\303\247a de viver.\",\n    outcome: \"Ressignifica\303\247\303\243o de traumas familiares, aumento expressivo da autoestima e seguran\303\247a pessoal.\"\n  }\n];\n\nexport const PAIN_POINTS: PainPoint[] = [\n  {\n    id: \'anxiety\',\n    title: \"Ansiedade & Preocupa\303\247\303\243o Constante\",\n    subtitle: \"A mente acelerada que parece nunca dar tr\303\251gua para repousar.\",\n    iconName: \"BrainCircuit\",\n    mainPain: \"Pensamentos catastr\303\263ficos em looping, aperto constante no peito, noites de sono rasas e a sensa\303\247\303\243o de que algo terr\303\255vel vai acontecer a qualquer segundo.\",\n    subconsciousMessage: \"Voc\303\252 carrega o fardo invis\303\255vel de tentar controlar o futuro para se sentir seguro, mas isso est\303\241 roubando a sua capacidade de desfrutar o seu presente.\",\n    approach: \"Na TCC de 4\302\252 Gera\303\247\303\243o (voltada \303\240 aceita\303\247\303\243o, aten\303\247\303\243o plena e flexibilidade mental), n\303\243o tentamos lutar desesperadamente contra seus pensamentos ansiosos. Ensinamos seu c\303\251rebro a observar essas hist\303\263rias sem se fundir a elas, reduzindo a hipervigil\303\242ncia neurol\303\263gica.\",\n    advice: \"DICA PR\303\201TICA: Quando a ansiedade atingir o pico, mude seu foco para a periferia do corpo. Sinta o peso dos seus p\303\251s tocando o solo e o tecido da sua roupa. A ansiedade vive no futuro; a realidade apoia-se no presente.\"\n  },\n  {\n    id: \'depression\',\n    title: \"Vazio Emocional & Tristeza Profunda\",\n    subtitle: \"Quando a vida perde o brilho acad\303\252mico e as cores parecem lavadas.\",\n    iconName: \"CloudRain\",\n    mainPain: \"Cansa\303\247o extremo que n\303\243o passa com o sono, apatia em rela\303\247\303\243o a hobbies que antes traziam alegria, culpa corrosiva e a sensa\303\247\303\243o de carregar um peso pesado no peito.\",\n    subconsciousMessage: \"O cansa\303\247o que voc\303\252 sente n\303\243o \303\251 pregui\303\247a f\303\255sica: \303\251 a sua mente entrando em exaust\303\243o ap\303\263s passar anos suprimindo dores, frustra\303\247\303\265es e tentativas herc\303\272leas de se encaixar.\",\n    approach: \"Integrando a Act (Terapia de Aceita\303\247\303\243o e Compromisso) com a Neuroci\303\252ncia, investigamos de maneira humanizada as necessidades profundas que foram silenciadas. Restauramos a conex\303\243o com seus valores fundamentais para dar novos objetivos vivos \303\240 sua rotina.\",\n    advice: \"DICA PR\303\201TICA: N\303\243o espere a \'vontade\' ou motiva\303\247\303\243o chegar para agir. A cura da depress\303\243o come\303\247a com micro-a\303\247\303\265es de autocuidado, mesmo sem vontade. O movimento cria a emo\303\247\303\243o, e n\303\243o o oposto.\"\n  },\n  {\n    id: \'trauma\',\n    title: \"Traumas & Cicatrizes do Passado\",\n    subtitle: \"Ecos do ontem que continuam ditando as regras das suas rea\303\247\303\265es hoje.\",\n    iconName: \"HeartCrack\",\n    mainPain: \"Gatilhos emocionais intensos que disparam por motivos aparentemente simples, medos irracionais de abandono ou rejei\303\247\303\243o e lembran\303\247as invasivas que invadem seus pensamentos.\",\n    subconsciousMessage: \"Sua crian\303\247a interna passou por momentos em que precisou criar armaduras pesadas para sobreviver. Mas as armaduras que te protegeram l\303\241 atr\303\241s agora est\303\243o te sufocando.\",\n    approach: \"Utilizamos t\303\251cnicas de reprocessamento cognitivo e compaix\303\243o cl\303\255nica. Criamos um ambiente luxuoso de total confidencialidade e seguran\303\247a absoluta para acolher as feridas antigas, gerando autocompaix\303\243o e reescrevendo o roteiro da sua pr\303\263pria hist\303\263ria.\",\n    advice: \"DICA PR\303\201TICA: Em um momento de gatilho traum\303\241tico, abrace-se firmemente de bra\303\247os cruzados e respire pausadamente. Lembre-se, em voz baixa: \'Aquele perigo acabou. Estou em seguran\303\247a aqui, agora.\'\"\n  },\n  {\n    id: \'dependence\',\n    title: \"Depend\303\252ncia Emocional & Medo de Solid\303\243o\",\n    subtitle: \"O esgotamento mental de viver pisando em ovos para nunca desagradar.\",\n    iconName: \"Users\",\n    mainPain: \"Anular todas as suas vontades para agradar o parceiro(a), medo desesperador de ser deixado sozinho, necessidade de valida\303\247\303\243o externa para validar suas menores escolhas cotidianas.\",\n    subconsciousMessage: \"Por medo de perder o amor do outro, voc\303\252 acabou cometendo o maior erro de todos: abandonou a si mesmo no processo.\",\n    approach: \"Fortalecemos a sua diferencia\303\247\303\243o do Eu e sua autonomia afetiva. Atrav\303\251s de treinos de assertividade comportamental e regula\303\247\303\243o emocional profunda, voc\303\252 descobrir\303\241 que sua companhia \303\251 um lugar seguro e extremamente rico de viver.\",\n    advice: \"DICA PR\303\201TICA: Comece a tomar pequenas decis\303\265es sozinho, sem pedir a aprova\303\247\303\243o de ningu\303\251m. Perceba que voc\303\252 \303\251 perfeitamente capaz de guiar suas escolhas e suportar as consequ\303\252ncias.\"\n  },\n  {\n    id: \'selfesteen\',\n    title: \"Baixa Autoestima & Autocobran\303\247a Cruel\",\n    subtitle: \"A voz julgadora interna que sabota suas conquistas antes de acontecerem.\",\n    iconName: \"ShieldAlert\",\n    mainPain: \"S\303\255ndrome do impostor no trabalho, compara\303\247\303\243o obsessiva com o feed impec\303\241vel das redes sociais alheias, sensa\303\247\303\243o de insufici\303\252ncia persistente mesmo sendo altamente qualificado.\",\n    subconsciousMessage: \"Sua mente aprendeu que seu valor depende estritamente das suas entregas e performance. Voc\303\252 se tornou seu carrasco mais impiedoso.\",\n    approach: \"Trabalhamos na desconstru\303\247\303\243o desse di\303\241logo interno destrutivo usando a Terapia Metacognitiva e o mindfulness. Substitu\303\255mos o chicote da autocobran\303\247a por uma responsabilidade compassiva e extremamente potente.\",\n    advice: \"DICA PR\303\201TICA: Da pr\303\263xima vez que cometer um erro, pergunte-se: \'Se um melhor amigo estivesse nessa situa\303\247\303\243o, eu diria as mesmas palavras duras para ele?\' Trate-se com a mesma classe e eleg\303\242ncia que trata os outros.\"\n  }\n];\n\nexport const ASSESSMENT_QUESTIONS: AssessmentQuestion[] = [\n  {\n    id: 1,\n    text: \"Com que frequ\303\252ncia voc\303\252 sente um aperto inexplic\303\241vel no peito ou pensamentos acelerados sobre coisas que ainda nem aconteceram?\",\n    category: \'anxiety\',\n    options: [\n      { text: \"Raramente ou quase nunca\", score: 0 },\n      { text: \"Algumas vezes na semana, sinto uma inquieta\303\247\303\243o sutil\", score: 2 },\n      { text: \"Quase todos os dias, sinto ang\303\272stia f\303\255sica e mente descontrolada\", score: 4 }\n    ]\n  },\n  {\n    id: 2,\n    text: \"Como voc\303\252 lida com a necessidade de aprova\303\247\303\243o e valida\303\247\303\243o das pessoas que se relacionam com voc\303\252?\",\n    category: \'dependence\',\n    options: [\n      { text: \"Me sinto seguro de minhas decis\303\265es mesmo que discordem\", score: 0 },\n      { text: \"Frequentemente mudo as minhas opini\303\265es ou atitudes para evitar conflitos\", score: 2 },\n      { text: \"D\303\263i de forma insuport\303\241vel pensar que algu\303\251m possa estar desapontado comigo\", score: 4 }\n    ]\n  },\n  {\n    id: 3,\n    text: \"Quando voc\303\252 pensa no seu futuro ou avalia as suas conquistas, qual sentimento predomina?\",\n    category: \'self_esteem\',\n    options: [\n      { text: \"Orgulho e otimismo realista pelas pr\303\263ximas etapas\", score: 0 },\n      { text: \"Sensa\303\247\303\243o de que sou uma farsa e de que nunca fa\303\247o o suficiente\", score: 2 },\n      { text: \"Desesperan\303\247a profunda e a certeza de que estou sempre atrasado\", score: 4 }\n    ]\n  },\n  {\n    id: 4,\n    text: \"Como tem sido a sua energia vital, o seu sono e a sua vontade de realizar atividades simples ultimamente?\",\n    category: \'depression\',\n    options: [\n      { text: \"Regular, durmo bem e consigo realizar meus planos\", score: 0 },\n      { text: \"Me sinto cansado emocionalmente, mas sigo operando no piloto autom\303\241tico\", score: 2 },\n      { text: \"Acordo sem for\303\247as, sinto um vazio persistente e um esgotamento indescrit\303\255vel\", score: 4 }\n    ]\n  },\n  {\n    id: 5,\n    text: \"Ao enfrentar uma mem\303\263ria desconfort\303\241vel de rejei\303\247\303\243o ou uma falha de postura no seu hist\303\263rico, qual \303\251 a sua rea\303\247\303\243o?\",\n    category: \'dependence\',\n    options: [\n      { text: \"Compreendo que era o meu melhor momento e sigo em frente\", score: 0 },\n      { text: \"Fico remoendo o ocorrido por dias, sentindo culpa silenciosa\", score: 2 },\n      { text: \"Isso revive instantaneamente gatilhos intensos e sinto dor como se fosse hoje\", score: 4 }\n    ]\n  }\n];\n\nexport const FAQS: FaqItem[] = [\n  {\n    category: \"Geral\",\n    question: \"Como funciona a psicoterapia online?\",\n    answer: \"A psicoterapia online \303\251 conduzida por videochamadas criptografadas de ponta a ponta, oferecendo o mesmo n\303\255vel de efic\303\241cia, calor humano e rigor \303\251tico de um atendimento presencial. Ela permite que voc\303\252 seja atendido no conforto e sigilo do seu lar, economizando tempo valioso com deslocamentos e facilitando o encaixe na rotina de quem viaja bastante.\"\n  },\n  {\n    category: \"Metodologia\",\n    question: \"O que \303\251 a TCC de 4\302\252 gera\303\247\303\243o?\",\n    answer: \"Se a primeira gera\303\247\303\243o focou no comportamento e a segunda nas distor\303\247\303\265es de pensamento, a 4\302\252 gera\303\247\303\243o da Terapia Cognitivo-Comportamental representa o \303\241pice da integra\303\247\303\243o cl\303\255nica. Ela une o rigor cient\303\255fico da neuroci\303\252ncia comportamental cl\303\241ssica com o mindfulness (aten\303\247\303\243o plena), Terapia de Aceita\303\247\303\243o e Compromisso (ACT), autocompaix\303\243o profunda e espiritualidade laica. foca n\303\243o apenas em \'silenciar\' sintomas, mas em desenvolver flexibilidade psicol\303\263gica para construir uma vida aut\303\252ntica que de fato valha a pena ser vivida.\"\n  },\n  {\n    category: \"Investimento & Atendimento\",\n    question: \"Voc\303\252 aceita plano de sa\303\272de / conv\303\252nio?\",\n    answer: \"Os atendimentos s\303\243o particulares para garantir a m\303\241xima excel\303\252ncia, tempo dedicado de estudo ao seu caso e privacidade \303\251tica absoluta. Emitimos recibo com todos os dados profissionais necess\303\241rios para voc\303\252 solicitar o reembolso integral ou parcial junto ao seu plano de sa\303\272de, conforme as regras da sua operadora.\"\n  },\n  {\n    category: \"Geral\",\n    question: \"Qual \303\251 a frequ\303\252ncia recomendada das consultas?\",\n    answer: \"Inicialmente, as sess\303\265es ocorrem semanalmente (com dura\303\247\303\243o aproximada de 50 minutos). Esse ritmo \303\251 crucial para estabelecer o v\303\255nculo anal\303\255tico, diagnosticar a din\303\242mica do sofrimento e implementar as ferramentas pr\303\241ticas. Conforme o paciente adquire autonomia emocional e regula\303\247\303\243o psicol\303\263gica, espa\303\247amos o intervalo de encontros de maneira planejada.\"\n  },\n  {\n    category: \"Metodologia\",\n    question: \"\303\211 indicado para adolescentes ou somente adultos?\",\n    answer: \"O Dr. Bruno de Oliveira Lima \303\251 altamente qualificado para atender tanto adolescentes quanto adultos. A abordagem integrativa adapta-se \303\240 faixa et\303\241ria: utilizando linguagens mais din\303\242micas e reflexivas para jovens em fase de estrutura\303\247\303\243o de identidade, e profundos insights l\303\263gicos e neurocient\303\255ficos para adultos focados em carreira, casamento e ressignifica\303\247\303\243o de passados complexos.\"\n  }\n];\n"
    }
