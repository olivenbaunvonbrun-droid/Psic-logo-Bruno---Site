      original_chunk {
        target_content: "        {/* Right Column: Replicating the Visual Identity exactly matching the photos */}\n        <div className=\"lg:col-span-5 flex justify-center items-center\">\n          <motion.div\n            id=\"hero-portrait-card\"\n            className=\"w-full max-w-[420px] rounded-2xl relative overflow-hidden bg-luxury-charcoal/40 border border-luxury-gold/20 p-5 shadow-2xl flex flex-col gap-6\"\n            initial={{ opacity: 0, scale: 0.95, y: 30 }}\n            animate={{ opacity: 1, scale: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.2 }}\n          >\n            {/* Top gold decor lines mimicking classic architectural styling arches */}\n            <div className=\"absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-luxury-go            {/* The Psychologist Frame: stylized depiction with dark elegant layout mimicking the first images */}\n            <div className=\"relative w-full aspect-[4/5] rounded-xl overflow-hidden bg-gradient-to-b from-[#1c1c20] to-[#0c0c0d] border border-white/[0.05] group flex flex-col justify-end items-center\">\n              \n              <img \n                src=\"/input_file_0.png\" \n                alt=\"Bruno de Oliveira - Psic\303\263logo Cl\303\255nico\" \n                className=\"absolute inset-0 w-full h-full object-cover object-top group-hover:scale-102 transition duration-700 pointer-events-none\" \n                referrerPolicy=\"no-referrer\"\n              />\n              \n              {/* Radial warm lighting overlay */}\n              <div className=\"absolute inset-0 bg-gradient-to-t from-luxury-black via-transparent to-transparent pointer-events-none\" />\n\n              {/* Overlay elements mapping directly onto the image visuals */}\n              <div className=\"relative z-10 w-[90%] mb-4 bg-luxury-black/90 p-4 rounded-lg border border-luxury-gold/20 backdrop-blur-md flex flex-col items-center shadow-lg\">\n                \n                {/* Gold Psi Mandala exactly representing the penult picture */}\n                <div className=\"w-10 h-10 rounded-full border border-luxury-gold/50 flex items-center justify-center bg-[#07090f] relative overflow-hidden shadow-inner\">\n                  <img \n                    src=\"/input_file_8.png\" \n                    alt=\"Logo\" \n                    className=\"w-full h-full object-contain p-1\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                </div>\n\n                {/* Elegant names */}\n                <h3 className=\"font-serif italic text-base text-white font-semibold mt-2.5 leading-none\">\n                  Bruno de Oliveira\n                </h3>\n                <p className=\"text-[10px] sm:text-xs text-luxury-gold-light tracking-widest font-sans font-medium uppercase mt-1\">\n                  PSIC\303\223LOGO | CRP 05/75885\n                </p>\n                <p className=\"text-[10px] font-mono text-luxury-text-muted mt-1.5 opacity-80\">\n                  (21) 97524-9514\n                </p>\n              </div>\n\n              {/* Visual sign with physical telephone to highlight real life representation */}\n              <span className=\"absolute top-3 left-3 bg-[#111]/90 border border-emerald-500/30 text-emerald-400 font-mono text-[9px] px-2.5 py-1 rounded-full flex items-center gap-1.5 backdrop-blur-sm\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping\" />\n                Sess\303\265es Dispon\303\255veis\n              </span>\n            </div>s\n              </span>\n            </div>"
