    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { ShieldCheck, Sparkles, MessageSquareHeart, CheckCircle, ArrowDown } from \'lucide-react\';\n\nexport default function Hero() {\n  const handleWhatsAppClick = () => {\n    const text = encodeURIComponent(\n      \"Ol\303\241, Dr. Bruno! Estou vindo do seu site de luxo e gostaria de agendar uma consulta inicial com voc\303\252.\"\n    );\n    window.open(`https://wa.me/5521975249514?text=${text}`, \'_blank\');\n  };\n\n  return (\n    <section \n      id=\"hero-root\"\n      className=\"relative min-h-screen pt-32 pb-20 flex items-center justify-center overflow-hidden bg-radial from-luxury-charcoal to-luxury-black\"\n    >\n      {/* Background ambient gold lights */}\n      <div className=\"absolute top-1/4 left-1/4 w-[40rem] h-[40rem] bg-luxury-gold/5 rounded-full blur-[120px] pointer-events-none\" />\n      <div className=\"absolute bottom-1/4 right-1/4 w-[35rem] h-[35rem] bg-luxury-gold/5 rounded-full blur-[100px] pointer-events-none\" />\n\n      {/* Decorative vertical lines representing clean architectural columns of premium office */}\n      <div className=\"absolute inset-0 bg-[linear-gradient(to_right,#ffffff03_1px,transparent_1px)] bg-[size:100px_100%] pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-6 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10\">\n        \n        {/* Left Content Column */}\n        <div className=\"lg:col-span-7 flex flex-col items-start text-left\">\n          \n          <motion.div \n            id=\"hero-tagline-badge\"\n            className=\"flex items-center gap-2 px-3 py-1.5 rounded-full bg-luxury-gold/10 border border-luxury-gold/20 text-[10px] sm:text-xs tracking-widest text-[#dfcaa7] font-sans font-medium uppercase mb-6\"\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.6 }}\n          >\n            <Sparkles className=\"w-3.5 h-3.5 text-luxury-gold\" />\n            <span>TCC de 4\302\252 Gera\303\247\303\243o & Neuroci\303\252ncia</span>\n          </motion.div>\n\n          <motion.h1 \n            id=\"hero-title\"\n            className=\"text-4xl sm:text-5xl md:text-6xl font-serif text-white tracking-tight leading-[1.1] mb-6\"\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.1 }}\n          >\n            Toda ferida silenciosa merece um <span className=\"gold-gradient-text italic font-medium\">olhar acolhedor</span> e humanizado.\n          </motion.h1>\n\n          <motion.p \n            id=\"hero-description\"\n            className=\"text-sm sm:text-base md:text-lg text-luxury-text-muted leading-relaxed font-sans font-light max-w-xl mb-10\"\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.2 }}\n          >\n            Seja bem-vindo a um porto seguro de transforma\303\247\303\243o pessoal. Sou o Dr. Bruno de Oliveira Lima, especialista em acolher ansiedade, traumas, esgotamentos e depend\303\252ncia emocional de maneira cient\303\255fica, humanizada e sob sigilo \303\251tico absoluto.\n          </motion.p>\n\n          {/* Quick value props */}\n          <motion.div \n            id=\"hero-features\"\n            className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10 w-full max-w-lg\"\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.3 }}\n          >\n            <div className=\"flex items-start gap-3\">\n              <CheckCircle className=\"w-5 h-5 text-luxury-gold shrink-0 mt-0.5\" />\n              <div>\n                <h4 className=\"text-sm font-semibold text-white tracking-wide\">Sem Julgamentos</h4>\n                <p className=\"text-xs text-luxury-text-muted mt-0.5\">Espa\303\247o pautado pelo acolhimento, respeito m\303\272tuo and dignidade humana.</p>\n              </div>\n            </div>\n            <div className=\"flex items-start gap-3\">\n              <CheckCircle className=\"w-5 h-5 text-luxury-gold shrink-0 mt-0.5\" />\n              <div>\n                <h4 className=\"text-sm font-semibold text-white tracking-wide\">Abordagem Integrada</h4>\n                <p className=\"text-xs text-luxury-text-muted mt-0.5\">O melhor da Psican\303\241lise, Humanismo, TCC e as Neuroci\303\252ncias.</p>\n              </div>\n            </div>\n            <div className=\"flex items-start gap-3\">\n              <CheckCircle className=\"w-5 h-5 text-luxury-gold shrink-0 mt-0.5\" />\n              <div>\n                <h4 className=\"text-sm font-semibold text-white tracking-wide\">Atendimento Online VIP</h4>\n                <p className=\"text-xs text-luxury-text-muted mt-0.5\">Consultas por videoconfer\303\252ncia com total sigilo criptografado.</p>\n              </div>\n            </div>\n            <div className=\"flex items-start gap-3\">\n              <CheckCircle className=\"w-5 h-5 text-luxury-gold shrink-0 mt-0.5\" />\n              <div>\n                <h4 className=\"text-sm font-semibold text-white tracking-wide\">CRP Ativo e Regular</h4>\n                <p className=\"text-xs text-luxury-text-muted mt-0.5\">Dr. Bruno de Oliveira Lima, Conselho de Psicologia CRP 05/75885.</p>\n              </div>\n            </div>\n          </motion.div>\n\n          {/* Action buttons */}\n          <motion.div \n            id=\"hero-actions\"\n            className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full\"\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.4 }}\n          >\n            <button\n              id=\"hero-whatsapp-btn\"\n              onClick={handleWhatsAppClick}\n              className=\"flex items-center justify-center gap-2.5 bg-gradient-to-r from-luxury-gold-dark via-luxury-gold to-luxury-gold-light text-luxury-black font-semibold text-sm uppercase tracking-wider px-8 py-4.5 rounded-full shadow-lg hover:shadow-luxury-gold/20 active:scale-95 transition cursor-pointer\"\n            >\n              <MessageSquareHeart className=\"w-5 h-5\" />\n              <span>Agendar Minha Consulta</span>\n            </button>\n            \n            <a\n              href=\"#terapeuta\"\n              id=\"hero-about-btn\"\n              className=\"flex items-center justify-center gap-2 border border-luxury-gold/30 hover:border-luxury-gold/70 text-luxury-gold-light hover:text-white px-8 py-4.5 rounded-full text-sm font-semibold uppercase tracking-wider transition\"\n            >\n              <span>Conhecer o Dr. Bruno</span>\n              <ArrowDown className=\"w-4 h-4 animate-bounce\" />\n            </a>\n          </motion.div>\n\n        </div>"
        replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { ShieldCheck, Sparkles, MessageSquareHeart, CheckCircle, ArrowDown } from \'lucide-react\';\n\nexport default function Hero() {\n  const handleWhatsAppClick = () => {\n    const text = encodeURIComponent(\n      \"Ol\303\241, Bruno! Acessei seu site e gostaria de agendar uma consulta inicial para cuidar da minha sa\303\272de emocional.\"\n    );\n    window.open(`https://wa.me/5521975249514?text=${text}`, \'_blank\');\n  };\n\n  return (\n    <section \n      id=\"hero-root\"\n      className=\"relative min-h-screen pt-32 pb-20 flex items-center justify-center overflow-hidden bg-radial from-luxury-charcoal to-luxury-black\"\n    >\n      {/* Background ambient gold lights */}\n      <div className=\"absolute top-1/4 left-1/4 w-[40rem] h-[40rem] bg-luxury-gold/5 rounded-full blur-[120px] pointer-events-none\" />\n      <div className=\"absolute bottom-1/4 right-1/4 w-[35rem] h-[35rem] bg-luxury-gold/5 rounded-full blur-[100px] pointer-events-none\" />\n\n      {/* Decorative vertical lines representing clean architectural columns of premium office */}\n      <div className=\"absolute inset-0 bg-[linear-gradient(to_right,#ffffff03_1px,transparent_1px)] bg-[size:100px_100%] pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-6 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10\">\n        \n        {/* Left Content Column */}\n        <div className=\"lg:col-span-7 flex flex-col items-start text-left\">\n          \n          <motion.div \n            id=\"hero-tagline-badge\"\n            className=\"flex items-center gap-2 px-3 py-1.5 rounded-full bg-luxury-gold/10 border border-luxury-gold/20 text-[10px] sm:text-xs tracking-widest text-[#dfcaa7] font-sans font-medium uppercase mb-6\"\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.6 }}\n          >\n            <Sparkles className=\"w-3.5 h-3.5 text-luxury-gold\" />\n            <span>TCC de 4\302\252 Gera\303\247\303\243o & Neuroci\303\252ncia Comportamental</span>\n          </motion.div>\n\n          <motion.h1 \n            id=\"hero-title\"\n            className=\"text-4xl sm:text-5xl md:text-6xl font-serif text-white tracking-tight leading-[1.1] mb-6\"\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.1 }}\n          >\n            Seu cansa\303\247o n\303\243o \303\251 pregui\303\247a. E esse <span className=\"gold-gradient-text italic font-medium\">aperto no peito</span> n\303\243o precisa ser o seu normal.\n          </motion.h1>\n\n          <motion.p \n            id=\"hero-description\"\n            className=\"text-sm sm:text-base md:text-lg text-luxury-text-muted leading-relaxed font-sans font-light max-w-xl mb-10\"\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.2 }}\n          >\n            Voc\303\252 n\303\243o precisa segurar o peso do mundo sozinho, fingindo for\303\247a enquanto desmorona em sil\303\252ncio por dentro. Sou Bruno de Oliveira, psic\303\263logo e terapeuta. Estou aqui para te oferecer um espa\303\247o seguro de escuta atenta, pautado pela ci\303\252ncia e pelo respeito absoluto \303\240 sua hist\303\263ria, para que voc\303\252 possa finalmente respirar em paz.\n          </motion.p>\n\n          {/* Quick value props */}\n          <motion.div \n            id=\"hero-features\"\n            className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10 w-full max-w-lg\"\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.3 }}\n          >\n            <div className=\"flex items-start gap-3\">\n              <CheckCircle className=\"w-5 h-5 text-luxury-gold shrink-0 mt-0.5\" />\n              <div>\n                <h4 className=\"text-sm font-semibold text-white tracking-wide\">Acolhimento da sua Dor</h4>\n                <p className=\"text-xs text-luxury-text-muted mt-0.5\">Um ref\303\272gio seguro onde voc\303\252 n\303\243o precisa usar m\303\241scaras nem fingir que est\303\241 bem.</p>\n              </div>\n            </div>\n            <div className=\"flex items-start gap-3\">\n              <CheckCircle className=\"w-5 h-5 text-luxury-gold shrink-0 mt-0.5\" />\n              <div>\n                <h4 className=\"text-sm font-semibold text-white tracking-wide\">Ci\303\252ncia com Alma</h4>\n                <p className=\"text-xs text-luxury-text-muted mt-0.5\">O melhor da TCC de \303\272ltima gera\303\247\303\243o e neuroci\303\252ncia focados no al\303\255vio do sofrimento.</p>\n              </div>\n            </div>\n            <div className=\"flex items-start gap-3\">\n              <CheckCircle className=\"w-5 h-5 text-luxury-gold shrink-0 mt-0.5\" />\n              <div>\n                <h4 className=\"text-sm font-semibold text-white tracking-wide\">Sess\303\265es Online Privadas</h4>\n                <p className=\"text-xs text-luxury-text-muted mt-0.5\">Terapia de onde voc\303\252 estiver, por chamada criptografada com sigilo absoluto.</p>\n              </div>\n            </div>\n            <div className=\"flex items-start gap-3\">\n              <CheckCircle className=\"w-5 h-5 text-luxury-gold shrink-0 mt-0.5\" />\n              <div>\n                <h4 className=\"text-sm font-semibold text-white tracking-wide\">Inscri\303\247\303\243o Profissional Ativa</h4>\n                <p className=\"text-xs text-luxury-text-muted mt-0.5\">Bruno de Oliveira Lima, cadastrado sob o n\303\272mero de registro CRP 05/75885.</p>\n              </div>\n            </div>\n          </motion.div>\n\n          {/* Action buttons */}\n          <motion.div \n            id=\"hero-actions\"\n            className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full\"\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.4 }}\n          >\n            <button\n              id=\"hero-whatsapp-btn\"\n              onClick={handleWhatsAppClick}\n              className=\"flex items-center justify-center gap-2.5 bg-gradient-to-r from-luxury-gold-dark via-luxury-gold to-luxury-gold-light text-luxury-black font-semibold text-sm uppercase tracking-wider px-8 py-4.5 rounded-full shadow-lg hover:shadow-luxury-gold/20 active:scale-95 transition cursor-pointer\"\n            >\n              <MessageSquareHeart className=\"w-5 h-5\" />\n              <span>Quero Al\303\255vio e Acolhimento</span>\n            </button>\n            \n            <a\n              href=\"#terapeuta\"\n              id=\"hero-about-btn\"\n              className=\"flex items-center justify-center gap-2 border border-luxury-gold/30 hover:border-luxury-gold/70 text-luxury-gold-light hover:text-white px-8 py-4.5 rounded-full text-sm font-semibold uppercase tracking-wider transition\"\n            >\n              <span>Conhecer o Terapeuta</span>\n              <ArrowDown className=\"w-4 h-4 animate-bounce\" />\n            </a>\n          </motion.div>\n\n        </div>"
