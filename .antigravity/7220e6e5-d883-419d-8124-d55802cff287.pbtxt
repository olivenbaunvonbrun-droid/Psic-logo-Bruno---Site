        }
        lines {
          text: "    role: \"Empreendedor de Tecnologia\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    text: \"Minhas rela\303\247\303\265es eram pautadas pela depend\303\252ncia emocional e o medo constante da rejei\303\247\303\243o. Eu me abandonava para agradar os outros e sofria com flutua\303\247\303\265es severas de humor e depress\303\243o silenciosa. A terapia com o Bruno me trouxe intelig\303\252ncia de verdade sobra as minhas emo\303\247\303\265es. Ele me ensinou conceitos da neuroci\303\252ncia e estrat\303\251gias pr\303\241ticas que mudaram minha forma de agir. O consult\303\263rio dele online \303\251 um ref\303\272gio de dignidade e acolhimento.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    outcome: \"Supera\303\247\303\243o da depend\303\252ncia emocional, independ\303\252ncia afetiva e estabiliza\303\247\303\243o do humor.\""
