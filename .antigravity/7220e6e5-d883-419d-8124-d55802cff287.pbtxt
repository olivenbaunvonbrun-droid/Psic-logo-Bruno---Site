          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    role: \"M\303\251dica Pediatra\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    text: \"O Bruno de Oliveira \303\251 de uma sensibilidade \303\255mpar. Carrego traumas de inf\303\242ncia complexos que reverberavam na minha forma de maternar e na minha autoestima. Ele une a profundidade da compreens\303\243o humana com ferramentas cient\303\255ficas de ponta. Sentir que voc\303\252 est\303\241 sendo verdadeiramente ouvida por um profissional de alt\303\255ssimo n\303\255vel, cuja miss\303\243o clara \303\251 reduzir a dor, muda de forma crucial a nossa autoconfian\303\247a de viver.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
