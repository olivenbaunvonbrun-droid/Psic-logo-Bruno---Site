        lines {
          text: "export const PAIN_POINTS: PainPoint[] = ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'anxiety\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    title: \"Ansiedade & Preocupa\303\247\303\243o Constante\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subtitle: \"A mente acelerada que parece nunca dar tr\303\251gua para repousar.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    iconName: \"BrainCircuit\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    mainPain: \"Pensamentos catastr\303\263ficos em looping, aperto constante no peito, noites de sono rasas e a sensa\303\247\303\243o de que algo terr\303\255vel vai acontecer a qualquer segundo.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subconsciousMessage: \"Voc\303\252 carrega o fardo invis\303\255vel de tentar controlar o futuro para se sentir seguro, mas isso est\303\241 roubando a sua capacidade de desfrutar o seu presente.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    approach: \"Na TCC de 4\302\252 Gera\303\247\303\243o (voltada \303\240 aceita\303\247\303\243o, aten\303\247\303\243o plena e flexibilidade mental), n\303\243o tentamos lutar desesperadamente contra seus pensamentos ansiosos. Ensinamos seu c\303\251rebro a observar essas hist\303\263rias sem se fundir a elas, reduzindo a hipervigil\303\242ncia neurol\303\263gica.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    advice: \"DICA PR\303\201TICA: Quando a ansiedade atingir o pico, mude seu foco para a periferia do corpo. Sinta o peso dos seus p\303\251s tocando o solo e o tecido da sua roupa. A ansiedade vive no futuro; a realidade apoia-se no presente.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'depression\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    title: \"Vazio Emocional & Tristeza Profunda\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subtitle: \"Quando a vida perde o brilho acad\303\252mico e as cores parecem lavadas.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    iconName: \"CloudRain\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    mainPain: \"Cansa\303\247o extremo que n\303\243o passa com o sono, apatia em rela\303\247\303\243o a hobbies que antes traziam alegria, culpa corrosiva e a sensa\303\247\303\243o de carregar um peso pesado no peito.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subconsciousMessage: \"O cansa\303\247o que voc\303\252 sente n\303\243o \303\251 pregui\303\247a f\303\255sica: \303\251 a sua mente entrando em exaust\303\243o ap\303\263s passar anos suprimindo dores, frustra\303\247\303\265es e tentativas herc\303\272leas de se encaixar.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    approach: \"Integrando a Act (Terapia de Aceita\303\247\303\243o e Compromisso) com a Neuroci\303\252ncia, investigamos de maneira humanizada as necessidades profundas que foram silenciadas. Restauramos a conex\303\243o com seus valores fundamentais para dar novos objetivos vivos \303\240 sua rotina.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    advice: \"DICA PR\303\201TICA: N\303\243o espere a \'vontade\' ou motiva\303\247\303\243o chegar para agir. A cura da depress\303\243o come\303\247a com micro-a\303\247\303\265es de autocuidado, mesmo sem vontade. O movimento cria a emo\303\247\303\243o, e n\303\243o o oposto.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'trauma\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    title: \"Traumas & Cicatrizes do Passado\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subtitle: \"Ecos do ontem que continuam ditando as regras das suas rea\303\247\303\265es hoje.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    iconName: \"HeartCrack\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    mainPain: \"Gatilhos emocionais intensos que disparam por motivos aparentemente simples, medos irracionais de abandono ou rejei\303\247\303\243o e lembran\303\247as invasivas que invadem seus pensamentos.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subconsciousMessage: \"Sua crian\303\247a interna passou por momentos em que precisou criar armaduras pesadas para sobreviver. Mas as armaduras que te protegeram l\303\241 atr\303\241s agora est\303\243o te sufocando.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    approach: \"Utilizamos t\303\251cnicas de reprocessamento cognitivo e compaix\303\243o cl\303\255nica. Criamos um ambiente luxuoso de total confidencialidade e seguran\303\247a absoluta para acolher as feridas antigas, gerando autocompaix\303\243o e reescrevendo o roteiro da sua pr\303\263pria hist\303\263ria.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    advice: \"DICA PR\303\201TICA: Em um momento de gatilho traum\303\241tico, abrace-se firmemente de bra\303\247os cruzados e respire pausadamente. Lembre-se, em voz baixa: \'Aquele perigo acabou. Estou em seguran\303\247a aqui, agora.\'\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'dependence\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    title: \"Depend\303\252ncia Emocional & Medo de Solid\303\243o\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subtitle: \"O esgotamento mental de viver pisando em ovos para nunca desagradar.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    iconName: \"Users\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    mainPain: \"Anular todas as suas vontades para agradar o parceiro(a), medo desesperador de ser deixado sozinho, necessidade de valida\303\247\303\243o externa para validar suas menores escolhas cotidianas.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subconsciousMessage: \"Por medo de perder o amor do outro, voc\303\252 acabou cometendo o maior erro de todos: abandonou a si mesmo no processo.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    approach: \"Fortalecemos a sua diferencia\303\247\303\243o do Eu e sua autonomia afetiva. Atrav\303\251s de treinos de assertividade comportamental e regula\303\247\303\243o emocional profunda, voc\303\252 descobrir\303\241 que sua companhia \303\251 um lugar seguro e extremamente rico de viver.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    advice: \"DICA PR\303\201TICA: Comece a tomar pequenas decis\303\265es sozinho, sem pedir a aprova\303\247\303\243o de ningu\303\251m. Perceba que voc\303\252 \303\251 perfeitamente capaz de guiar suas escolhas e suportar as consequ\303\252ncias.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'selfesteen\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    title: \"Baixa Autoestima & Autocobran\303\247a Cruel\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subtitle: \"A voz julgadora interna que sabota suas conquistas antes de acontecerem.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    iconName: \"ShieldAlert\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    mainPain: \"S\303\255ndrome do impostor no trabalho, compara\303\247\303\243o obsessiva com o feed impec\303\241vel das redes sociais alheias, sensa\303\247\303\243o de insufici\303\252ncia persistente mesmo sendo altamente qualificado.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subconsciousMessage: \"Sua mente aprendeu que seu valor depende estritamente das suas entregas e performance. Voc\303\252 se tornou seu carrasco mais impiedoso.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    approach: \"Trabalhamos na desconstru\303\247\303\243o desse di\303\241logo interno destrutivo usando a Terapia Metacognitiva e o mindfulness. Substitu\303\255mos o chicote da autocobran\303\247a por uma responsabilidade compassiva e extremamente potente.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    advice: \"DICA PR\303\201TICA: Da pr\303\263xima vez que cometer um erro, pergunte-se: \'Se um melhor amigo estivesse nessa situa\303\247\303\243o, eu diria as mesmas palavras duras para ele?\' Trate-se com a mesma classe e eleg\303\242ncia que trata os outros.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
