        }
        lines {
          text: "    id: \'t1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    name: \"Mariana S.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    age: 34,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    location: \"Rio de Janeiro - RJ\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    role: \"Advogada Corporativa\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    text: \"Cheguei ao Dr. Bruno carregando um esgotamento terr\303\255vel e uma ansiedade que travava meu peito todas as manh\303\243s. Eu sentia que precisava ser perfeita em tudo, mas s\303\263 acumulava medos e depend\303\252ncia da opini\303\243o alheia. A psicoterapia foi um divisor de \303\241guas. O jeito firme, por\303\251m profundamente humano e sem julgamentos do Bruno, apoiado na TCC de 4\302\252 gera\303\247\303\243o, me fez compreender e acolher minha hist\303\263ria. Hoje respiro mais leve, sei colocar limites e recuperei o comando da minha mente.\","
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    text: \"Cheguei ao Bruno carregando um esgotamento terr\303\255vel e uma ansiedade que travava meu peito todas as manh\303\243s. Eu sentia que precisava ser perfeita em tudo, mas s\303\263 acumulava medos e depend\303\252ncia da opini\303\243o alheia. A psicoterapia foi um divisor de \303\241guas. O jeito firme, por\303\251m profundamente humano e sem julgamentos do Bruno, apoiado na TCC de 4\302\252 gera\303\247\303\243o, me fez compreender e acolher minha hist\303\263ria. Hoje respiro mais leve, sei colocar limites e recuperei o comando da minha mente.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    outcome: \"Recupera\303\247\303\243o do p\303\242nico e burnout, restabelecimento de limites saud\303\241veis de trabalho.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'t2\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    name: \"Rodrigo M.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    age: 29,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    location: \"S\303\243o Paulo - SP\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    role: \"Empreendedor de Tecnologia\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    text: \"Minhas rela\303\247\303\265es eram pautadas pela depend\303\252ncia emocional e o medo constante da rejei\303\247\303\243o. Eu me abandonava para agradar os outros e sofria com flutua\303\247\303\265es severas de humor e depress\303\243o silenciosa. A terapia com o Bruno me trouxe intelig\303\252ncia de verdade sobra as minhas emo\303\247\303\265es. Ele me ensinou conceitos da neuroci\303\252ncia e estrat\303\251gias pr\303\241ticas que mudaram minha forma de agir. O consult\303\263rio dele online \303\251 um ref\303\272gio de dignidade e acolhimento.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    outcome: \"Supera\303\247\303\243o da depend\303\252ncia emocional, independ\303\252ncia afetiva e estabiliza\303\247\303\243o do humor.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \'t3\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    name: \"Helo\303\255sa F.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    age: 42,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    location: \"Niter\303\263i - RJ\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    role: \"M\303\251dica Pediatra\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    text: \"O Dr. Bruno de Oliveira \303\251 de uma sensibilidade \303\255mpar. Carrego traumas de inf\303\242ncia complexos que reverberavam na minha forma de maternar e na minha autoestima. Ele une a profundidade da compreens\303\243o humana com ferramentas cient\303\255ficas de ponta. Sentir que voc\303\252 est\303\241 sendo verdadeiramente ouvida por um profissional de alt\303\255ssimo n\303\255vel, cuja miss\303\243o clara \303\251 reduzir a dor, muda de forma crucial a nossa autoconfian\303\247a de viver.\","
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    text: \"O Bruno de Oliveira \303\251 de uma sensibilidade \303\255mpar. Carrego traumas de inf\303\242ncia complexos que reverberavam na minha forma de maternar e na minha autoestima. Ele une a profundidade da compreens\303\243o humana com ferramentas cient\303\255ficas de ponta. Sentir que voc\303\252 est\303\241 sendo verdadeiramente ouvida por um profissional de alt\303\255ssimo n\303\255vel, cuja miss\303\243o clara \303\251 reduzir a dor, muda de forma crucial a nossa autoconfian\303\247a de viver.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    outcome: \"Ressignifica\303\247\303\243o de traumas familiares, aumento expressivo da autoestima e seguran\303\247a pessoal.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
