        }
        lines {
          text: "    category: \"Investimento & Atendimento\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    question: \"Voc\303\252 aceita plano de sa\303\272de / conv\303\252nio?\","
