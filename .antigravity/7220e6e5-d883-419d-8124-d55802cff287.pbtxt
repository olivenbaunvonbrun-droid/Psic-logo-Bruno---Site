      target_content: "@import url(\'https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Inter:wght@200;300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-serif: \"Playfair Display\", Georgia, serif;\n  --font-sans: \"Inter\", system-ui, sans-serif;\n  --font-cinzel: \"Cinzel\", serif;\n\n  --color-luxury-gold: #c5a880;\n  --color-luxury-gold-light: #dfcaa7;\n  --color-luxury-gold-dark: #a1835b;\n  --color-luxury-black: #0c0c0d;\n  --color-luxury-charcoal: #151518;\n  --color-luxury-gray: #1f1f23;\n  --color-luxury-light-gray: #2c2c32;\n  --color-luxury-text-muted: #94949e;\n}\n\n@layer base {\n  body {\n    background-color: var(--color-luxury-black);\n    color: #f3f4f6;\n    font-family: var(--font-sans);\n    scroll-behavior: smooth;\n    overflow-x: hidden;\n  }\n\n  h1, h2, h3, h4, .font-serif {\n    font-family: var(--font-serif);\n  }\n}\n\n/* Custom visual styles for extra luxury feeling */\n.gold-gradient-text {\n  background: linear-gradient(135deg, #f3e5ab 0%, #c5a880 50%, #a1835b 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.gold-gradient-bg {\n  background: linear-gradient(135deg, #dfcaa7 0%, #c5a880 50%, #a1835b 100%);\n}\n\n.gold-border {\n  border-color: rgba(197, 168, 128, 0.25);\n}\n\n.gold-border-hover:hover {\n  border-color: rgba(197, 168, 128, 0.6);\n  box-shadow: 0 0 15px rgba(197, 168, 128, 0.15);\n}\n\n/* Soft scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n}\n::-webkit-scrollbar-track {\n  background: #09090a;\n}\n::-webkit-scrollbar-thumb {\n  background: #252528;\n  border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #c5a880;\n}"
      replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Inter:wght@200;300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-serif: \"Playfair Display\", Georgia, serif;\n  --font-sans: \"Inter\", system-ui, sans-serif;\n  --font-cinzel: \"Cinzel\", serif;\n\n  --color-luxury-gold: #C5A059;\n  --color-luxury-gold-light: #E0C18C;\n  --color-luxury-gold-dark: #A5803B;\n  --color-luxury-black: #0A0A0A;\n  --color-luxury-charcoal: #121212;\n  --color-luxury-gray: #1A1A1A;\n  --color-luxury-light-gray: #242424;\n  --color-luxury-text-muted: #A3A3A3;\n}\n\n@layer base {\n  body {\n    background-color: var(--color-luxury-black);\n    color: #E5E5E5;\n    font-family: var(--font-sans);\n    scroll-behavior: smooth;\n    overflow-x: hidden;\n  }\n\n  h1, h2, h3, h4, .font-serif {\n    font-family: var(--font-serif);\n  }\n}\n\n/* Elegant radial dotted pattern */\n.elegant-dots {\n  background-image: radial-gradient(#C5A059 0.5px, transparent 0.5px);\n  background-size: 24px 24px;\n}\n\n/* Custom visual styles for extra luxury feeling */\n.gold-gradient-text {\n  background: linear-gradient(135deg, #E0C18C 0%, #C5A059 50%, #A5803B 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.gold-gradient-bg {\n  background: linear-gradient(135deg, #E0C18C 0%, #C5A059 50%, #A5803B 100%);\n}\n\n.gold-border {\n  border-color: rgba(197, 160, 89, 0.2);\n}\n\n.gold-border-hover:hover {\n  border-color: rgba(197, 160, 89, 0.5);\n  box-shadow: 0 0 15px rgba(197, 160, 89, 0.15);\n}\n\n/* Soft scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n}\n::-webkit-scrollbar-track {\n  background: #060606;\n}\n::-webkit-scrollbar-thumb {\n  background: #1C1C1C;\n  border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #C5A059;\n}"
    }
