        }
        lines {
          text: "    name: \"Rodrigo M.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    age: 29,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
